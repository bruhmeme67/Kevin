{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 285,
  "background": null,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "titlePadding": 13,
      "labelColor": "#4d6158",
      "titleColor": "#4d6158",
      "gridColor": "#e4ebe6",
      "domain": false,
      "tickColor": "#ced9d1",
      "labelPadding": 6,
      "labelLimit": 180
    },
    "legend": {
      "title": null,
      "labelFontSize": 13,
      "orient": "top",
      "symbolSize": 100,
      "padding": 8,
      "labelColor": "#193c32",
      "labelLimit": 180
    },
    "text": {
      "fontSize": 13,
      "color": "#193c32"
    },
    "title": {
      "fontSize": 15,
      "anchor": "start",
      "color": "#193c32"
    }
  },
  "data": {
    "url": "data/annual.json"
  },
  "params": [
    {
      "name": "sectorFocus",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Nursery",
          "Cut flowers",
          "Turf"
        ],
        "name": "Highlight sector: "
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "financial_year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "production_index",
      "type": "quantitative",
      "title": "Production value \u00b7 2020/21 = 100",
      "scale": {
        "domain": [
          92,
          120
        ],
        "zero": false
      }
    },
    "color": {
      "field": "sector",
      "type": "nominal",
      "scale": {
        "domain": [
          "Nursery",
          "Cut flowers",
          "Turf"
        ],
        "range": [
          "#147d64",
          "#b63468",
          "#ae7c24"
        ]
      },
      "legend": {
        "orient": "top"
      }
    },
    "opacity": {
      "condition": {
        "test": "sectorFocus == \"All\" || datum.sector == sectorFocus",
        "value": 1
      },
      "value": 0.15
    },
    "tooltip": [
      {
        "field": "sector",
        "type": "nominal",
        "title": "Sector"
      },
      {
        "field": "financial_year",
        "type": "nominal",
        "title": "Year"
      },
      {
        "field": "production",
        "type": "quantitative",
        "title": "Production (A$m)",
        "format": ",.1f"
      },
      {
        "field": "production_index",
        "type": "quantitative",
        "title": "Index",
        "format": ".1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "point": {
          "filled": true,
          "size": 60
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "baseline": 100
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ],
        "color": "#71887a"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "x2": {
          "value": {
            "expr": "width"
          }
        },
        "y": {
          "field": "baseline",
          "type": "quantitative"
        },
        "color": {
          "value": "#71887a"
        },
        "opacity": {
          "value": 0.6
        },
        "tooltip": []
      }
    }
  ]
}
