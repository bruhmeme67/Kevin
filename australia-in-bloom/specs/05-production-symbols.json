{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 385,
  "background": null,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "titlePadding": 13,
      "labelColor": "#4d6158",
      "titleColor": "#4d6158",
      "gridColor": "#e4ebe6",
      "domain": false,
      "tickColor": "#ced9d1",
      "labelPadding": 6,
      "labelLimit": 180
    },
    "legend": {
      "title": null,
      "labelFontSize": 13,
      "orient": "top",
      "symbolSize": 100,
      "padding": 8,
      "labelColor": "#193c32",
      "labelLimit": 180
    },
    "text": {
      "fontSize": 13,
      "color": "#193c32"
    },
    "title": {
      "fontSize": 15,
      "anchor": "start",
      "color": "#193c32"
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ],
    "center": [
      0,
      -27
    ]
  },
  "params": [
    {
      "name": "mapSector",
      "value": "Cut flowers",
      "bind": {
        "input": "select",
        "options": [
          "Cut flowers",
          "Nursery"
        ],
        "name": "Compare sector: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/australia.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#edf1ec",
        "stroke": "white",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "url": "data/states.json"
      },
      "transform": [
        {
          "calculate": "mapSector == \"Cut flowers\" ? datum.flower_production : datum.nursery_production",
          "as": "value"
        },
        {
          "filter": "isValid(datum.value)"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "white",
        "strokeWidth": 1.2,
        "opacity": 0.8,
        "color": {
          "expr": "mapSector == \"Cut flowers\" ? \"#b63468\" : \"#147d64\""
        }
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "range": [
              0,
              3000
            ],
            "zero": true
          },
          "legend": {
            "orient": "bottom",
            "title": "Production (A$m)",
            "format": ",.0f"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Production (A$m)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/states.json"
      },
      "transform": [
        {
          "filter": "datum.abbr != \"ACT\""
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "dy": {
          "expr": "datum.abbr == \"TAS\" ? 18 : datum.abbr == \"VIC\" ? 0 : -32"
        },
        "dx": {
          "expr": "datum.abbr == \"VIC\" ? -40 : 0"
        },
        "color": "#193c32"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "abbr"
        }
      }
    }
  ]
}
